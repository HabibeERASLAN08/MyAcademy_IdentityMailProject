@model LoginDto
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<h1>Giriş Yap</h1>
<!-- Login Card -->
<div class="w-full max-w-[420px] bg-white rounded-[16px] shadow-ambient border border-border-light p-[40px]">
    <!-- Headers -->
    <div class="mb-8 text-center">
        <h2 class="font-headline-lg text-headline-lg text-navy mb-2">Tekrar Hoş Geldiniz</h2>
        <p class="font-body-md text-body-md text-dark-brown">Devam etmek için giriş yapın.</p>
    </div>
    <!-- Form -->
    <form class="space-y-6" method="POST">
      
        <span class="text-red-600 text-sm">@Html.ValidationSummary(false)</span>
        <!-- Email Input -->
        <div class="space-y-2">
            <label class="block font-label-md text-label-md text-navy" asp-for="Email">E-posta</label>
            <div class="relative input-focus rounded-input border border-border-light bg-white transition-all duration-200">
                <input class="w-full h-[44px] px-4 rounded-input border-0 bg-transparent text-on-surface font-body-md text-body-md placeholder:text-outline-variant focus:ring-0 focus:outline-none" asp-for="Email" placeholder="ornek@sirket.com" required="" type="email" />
            </div>
        </div>
        <!-- Password Input -->
        <div class="space-y-2">
            <label class="block font-label-md text-label-md text-navy" asp-for="Password">Şifre</label>
            <div class="relative input-focus rounded-input border border-border-light bg-white transition-all duration-200 flex items-center">
                <input class="w-full h-[44px] pl-4 pr-10 rounded-input border-0 bg-transparent text-on-surface font-body-md text-body-md placeholder:text-outline-variant focus:ring-0 focus:outline-none" asp-for="Password" placeholder="••••••••" required="" type="password" />
               
            </div>
            <!-- Mock Error Text -->
            <p class="text-primary-container font-label-md text-[13px] mt-1 hidden">Geçersiz giriş bilgileri</p>
        </div>
        <!-- Submit Button -->
        <button class="w-full h-[44px] bg-primary-container text-white rounded-input font-label-md text-label-md hover:bg-surface-tint transition-colors duration-200 flex items-center justify-center" type="submit">
            Giriş Yap
        </button>
    </form>
    
    <!-- Footer Links -->
    <div class="mt-8 flex flex-col sm:flex-row justify-between items-center gap-4 border-t border-border-light pt-6">
        <a class="font-label-md text-label-md text-dark-brown hover:text-primary-container transition-colors font-medium" asp-controller="Auth" asp-action="Register">Kayıt ol</a>
        <a class="font-label-md text-label-md text-outline hover:text-primary-container transition-colors" asp-controller="Auth" asp-action="ForgotPassword">Şifremi unuttum</a>
    </div>
