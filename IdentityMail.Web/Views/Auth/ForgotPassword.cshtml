@model ForgotPasswordDto
@{
    ViewData["Title"] = "ForgotPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="w-full max-w-[420px] bg-surface-container-lowest rounded-[16px] border border-outline-variant p-[40px]">
<!-- Header Content -->
<div class="text-center mb-md w-full">
    <h2 class="font-headline-md text-headline-md text-on-surface mb-sm">Şifremi Unuttum</h2>
    <p class="font-body-md text-body-md text-on-surface-variant">
        “Kayıtlı e-posta adresinizi girin. Doğrulandıktan sonra yeni şifre belirleme ekranına yönlendirileceksiniz.”
    </p>
</div>
<!-- Form -->
<form class="w-full flex flex-col gap-md" method="post">
    <!-- Email Input Group -->
    <div class="flex flex-col gap-xs">
        <label class="font-label-md text-label-md text-[#3D4A6B]" asp-for="Email">E-posta</label>
            <input class="w-full bg-surface-container-lowest border border-outline-variant rounded-[12px] px-md py-sm font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-transparent transition-shadow duration-200" asp-for="Email" placeholder="ornek@sirket.com" required="" type="email" />
    </div>
    <!-- Actions -->
    <div class="flex flex-col gap-sm mt-sm">
        <button class="w-full bg-primary-container text-on-primary rounded-[12px] py-sm font-label-md text-label-md flex items-center justify-center gap-xs hover:bg-surface-tint transition-colors duration-200" type="submit">
            Gönder
        </button>
            <span class="text-red-600 text-sm">@Html.ValidationSummary(false)</span>
        <a class="w-full text-center font-label-md text-label-md text-primary hover:underline py-sm mt-xs" asp-controller="Auth" asp-action="Login">
            Girişe dön
        </a>
    </div>
        
</form>
</div>
