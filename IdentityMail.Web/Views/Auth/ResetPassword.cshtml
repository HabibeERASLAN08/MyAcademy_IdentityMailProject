@model ResetPasswordDto
@{
    ViewData["Title"] = "ResetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<!-- Auth Card -->
<div class="w-full max-w-[420px] bg-surface-container-lowest border border-outline-variant rounded-[16px] shadow-[0px_4px_20px_rgba(61,74,107,0.04)] p-lg flex flex-col gap-md">
    <div class="flex flex-col gap-sm text-center">
        <h2 class="font-display text-headline-md text-on-surface">Yeni Şifre Belirle</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">Lütfen hesabınız için yeni bir şifre girin.</p>
    </div>
    @if (ViewBag.SuccessMessage != null)
    {
        <div class="w-full rounded-[12px] px-4 py-3 text-center" style="background:#efe4ea; color:#3D4A6B; border:1px solid #8B5A7A;">
            @ViewBag.SuccessMessage
        </div>
    }
    <form class="flex flex-col gap-md mt-sm" method="POST">
        <!-- Password Input -->
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />
        <span class="text-red-600 text-sm">@Html.ValidationSummary(false)</span>
        <div class="flex flex-col gap-base">
            <label class="font-label-md text-label-md text-on-secondary-fixed-variant" asp-for="NewPassword">Yeni şifre</label>
            <div class="relative">
                <input class="w-full bg-surface-container-lowest border border-outline-variant rounded-xl px-sm py-sm font-body-md text-body-md text-on-surface placeholder:text-outline-variant focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-transparent transition-all duration-200" asp-for="NewPassword" placeholder="••••••••" required="" type="password" />
                <span class="material-symbols-outlined absolute right-sm top-1/2 -translate-y-1/2 text-outline-variant select-none pointer-events-none" data-icon="lock" style="font-variation-settings: 'FILL' 0;">lock</span>
            </div>
        </div>
        <!-- Confirm Password Input -->
        <div class="flex flex-col gap-base">
            <label class="font-label-md text-label-md text-on-secondary-fixed-variant" asp-for="ConfirmPassword">Şifre tekrar</label>
            <div class="relative">
                <input class="w-full bg-surface-container-lowest border border-outline-variant rounded-xl px-sm py-sm font-body-md text-body-md text-on-surface placeholder:text-outline-variant focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-transparent transition-all duration-200" asp-for="ConfirmPassword" placeholder="••••••••" required="" type="password" />
                <span class="material-symbols-outlined absolute right-sm top-1/2 -translate-y-1/2 text-outline-variant select-none pointer-events-none" data-icon="lock_reset" style="font-variation-settings: 'FILL' 0;">lock_reset</span>
            </div>
        </div>
        <!-- Action Button -->
        <button class="w-full bg-primary-container text-on-primary-container font-body-md text-body-md font-medium rounded-xl py-sm mt-xs hover:bg-surface-tint hover:text-white transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-container focus:ring-offset-surface-container-lowest" type="submit">
            Kaydet
        </button>
    </form>
</div>
<!-- Back to Login Link -->
<div class="mt-lg">
    <a class="font-body-md text-body-md text-primary font-medium hover:underline transition-all duration-200 flex items-center gap-xs" asp-controller="Auth" asp-action="Login">
        <span class="material-symbols-outlined text-[18px]" data-icon="arrow_back" style="font-variation-settings: 'FILL' 0;">arrow_back</span>
        Girişe dön
    </a>
</div>
@if (ViewBag.SuccessMessage != null)
{
    <script>
        setTimeout(function () {
            window.location.href = "/Auth/Login";
        }, 2500);
    </script>
}
