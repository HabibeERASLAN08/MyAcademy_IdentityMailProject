@model ChangePasswordDto
@{
    ViewData["Title"] = "Şifre Değiştir";
    Layout = "~/Views/Shared/_MailLayout.cshtml";
}

<div class="w-full max-w-auth-width mx-auto mt-lg lg:mt-[120px] px-md">
    <h1 class="font-headline-lg text-headline-lg text-on-surface mb-lg text-left">Şifre değiştir</h1>
    <form class="bg-surface-container-lowest p-md rounded-xl border border-outline-variant shadow-[0_4px_20px_rgba(61,74,107,0.04)] flex flex-col gap-md" asp-action="ChangePassword" method="post">
        <div class="flex flex-col gap-xs">
            <label class="font-label-md text-label-md text-secondary" asp-for="CurrentPassword">Mevcut şifre</label>
            <input class="w-full h-12 rounded-lg border border-outline-variant bg-surface-container-lowest px-sm font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-shadow" asp-for="CurrentPassword" placeholder="Mevcut şifrenizi girin" type="password" />
        </div>
        <div class="flex flex-col gap-xs">
            <label class="font-label-md text-label-md text-secondary" asp-for="NewPassword">Yeni şifre</label>
            <input class="w-full h-12 rounded-lg border border-outline-variant bg-surface-container-lowest px-sm font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-shadow" asp-for="NewPassword" placeholder="Yeni şifrenizi girin" type="password" />
        </div>
        <div class="flex flex-col gap-xs">
            <label class="font-label-md text-label-md text-secondary" asp-for="ConfirmPassword">Yeni şifre tekrar</label>
            <input class="w-full h-12 rounded-lg border border-outline-variant bg-surface-container-lowest px-sm font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-shadow" asp-for="ConfirmPassword" placeholder="Yeni şifrenizi tekrar girin" type="password" />
        </div>
        <div class="pt-sm flex flex-col gap-md">
            <button class="w-full h-12 bg-primary-container text-on-primary rounded-lg font-label-md text-label-md font-medium hover:bg-opacity-90 active:bg-opacity-100 transition-colors" type="submit">
                Kaydet
            </button>
            <div class="text-center">
                <a class="font-label-md text-label-md text-primary-container hover:underline hover:text-primary transition-colors" asp-controller="Profile" asp-action="Index">Profile geri dön</a>
            </div>
        </div>
    </form>
    <div asp-validation-summary="All" class="text-error"></div>
</div>

