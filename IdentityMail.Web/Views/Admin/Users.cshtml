@model List<IdentityMail.Web.DTOs.AdminDtos.AdminUserRow>
@{
    Layout = "_MailLayout";
    ViewData["Title"] = "Üyeler";
}

<div class="h-14 border-b border-outline-variant flex items-center px-md justify-between bg-surface-container-lowest shrink-0">
    <h1 class="text-[22px] font-semibold tracking-tight text-on-surface">Üyeler</h1>
    <span class="font-body-md text-[13px] text-on-surface-variant">@(ViewBag.TotalCount is int totalCount ? totalCount : Model.Count) üye</span>
</div>
<div class="flex-1 overflow-y-auto">
    @foreach (var item in Model)
    {
        <div class="flex items-center px-md py-3 border-b border-outline-variant bg-surface-container-lowest hover:bg-surface-container-highest transition-colors duration-200">
            <div class="flex-1 min-w-0">
                <p class="font-body-md text-on-surface truncate">@item.FullName</p>
                <p class="font-label-md text-on-surface-variant truncate">@item.Email</p>
            </div>
            <span class="shrink-0 text-[11px] px-2 py-0.5 rounded-full mr-sm @(item.IsAdmin ? "bg-primary-container text-on-primary" : "bg-surface-container-high text-on-surface-variant")">@(item.IsAdmin ? "Admin" : "User")</span>
            <span class="shrink-0 text-[11px] px-2 py-0.5 rounded-full mr-sm @(item.IsPassive ? "bg-error-container text-error" : "bg-surface-container-high text-on-surface-variant")">@(item.IsPassive ? "Pasif" : "Aktif")</span>
            <form asp-controller="Admin" asp-action="ToggleAdmin" asp-route-id="@item.Id" method="post" class="mr-xs">
                <button type="submit" disabled="@(item.Id == (int)ViewBag.CurrentUserId)" class="p-2 rounded-full hover:bg-surface-container-low text-on-surface-variant disabled:opacity-30 disabled:pointer-events-none" title="Rol değiştir">
                    <span class="material-symbols-outlined text-[20px]">manage_accounts</span>
                </button>
            </form>
            <form asp-controller="Admin" asp-action="TogglePassive" asp-route-id="@item.Id" method="post">
                <button type="submit" disabled="@(item.Id == (int)ViewBag.CurrentUserId)" class="p-2 rounded-full hover:bg-error-container text-on-surface-variant hover:text-error disabled:opacity-30 disabled:pointer-events-none" title="@(item.IsPassive ? "Aktif yap" : "Pasif yap")">
                    <span class="material-symbols-outlined text-[20px]">@(item.IsPassive ? "person" : "person_off")</span>
                </button>
            </form>
        </div>
    }
</div>
<partial name="_MailPager" />
