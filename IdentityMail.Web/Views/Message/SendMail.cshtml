@using IdentityMail.Web.DTOs.UserMessagesDtos
@model SendMailDto

@{
    ViewData["Title"] = "SendMail";
}

<h1>Yeni Mail Gönder</h1>

<form method="post">
    <label>Alıcı Mail</label>
    <input type="email" asp-for="ReceiverMail" class="form-control" required />
    <br />
    <label>Konu</label>
    <input type="text" asp-for="Subject" class="form-control" required />
    <br />
    <label>Mail İçeriği</label>
    <textarea type="password" asp-for="Body" class="form-control" required rows="10">
    </textarea>
    <br />

    <span class="text-danger">@Html.ValidationSummary()</span>

    <button class="btn btn-outline-dark">Gönder</button>
</form>

