@model UserMessage
@{
    Layout = "_MailLayout";
    ViewData["Title"] = "Mail Detay";
}

<!-- Top Toolbar -->
<header class="h-[72px] flex items-center justify-between px-md border-b border-surface-container-highest bg-surface-container-lowest shrink-0">
    <div class="flex items-center gap-md">
        <a asp-controller="Message" asp-action="Index" aria-label="Geri" class="p-xs rounded-full hover:bg-surface-container text-on-surface-variant transition-colors flex items-center justify-center">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div class="h-6 w-px bg-outline-variant"></div>
        <div class="flex items-center gap-sm">
            <a asp-controller="Message" asp-action="ToggleImportant" asp-route-id="@Model.Id" aria-label="Yıldız" class="p-xs rounded-lg hover:bg-surface-container text-on-surface-variant transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined @(Model.IsImportant ? "text-primary" : "")" style="font-variation-settings: 'FILL' @(Model.IsImportant ? 1 : 0);">star</span>
            </a>
            <a aria-label="Sil" asp-controller="Message" asp-action="MoveToTrash" asp-route-id="@Model.Id" class="p-xs rounded-lg hover:bg-surface-container text-on-surface-variant transition-colors flex items-center gap-base font-label-md text-label-md">
                <span class="material-symbols-outlined">delete</span>
                <span class="hidden sm:inline">Sil</span>
            </a>
            <div class="h-6 w-px bg-outline-variant mx-xs"></div>
            <button type="button" aria-label="Okunmadı İşaretle" class="p-xs rounded-lg hover:bg-surface-container text-on-surface-variant transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined">mark_email_unread</span>
            </button>
        </div>
    </div>
  
</header>
<!-- Email Content Scrollable Area -->
<div class="flex-1 overflow-y-auto p-md lg:p-lg flex justify-center">
    <article class="w-full max-w-container-max bg-surface-container-lowest rounded-[16px] border border-surface-container-highest p-md lg:p-lg shadow-[0px_4px_20px_rgba(61,74,107,0.04)] h-fit">
        <!-- Email Header Info -->
        <header class="mb-lg border-b border-surface-container-highest pb-md">
            <div class="flex flex-col md:flex-row md:items-start justify-between gap-md mb-md">
                <h2 class="font-headline-lg text-headline-lg text-[#3D4A6B]">@Model.Subject</h2>
                <span class="font-label-md text-label-md text-on-surface-variant whitespace-nowrap bg-surface-container px-sm py-xs rounded-full h-fit flex items-center gap-xs">
                    <span class="material-symbols-outlined" style="font-size: 16px;">schedule</span>
                    @Model.SendDate.ToString("dd.MM.yyyy HH:mm")
                </span>
            </div>
            <div class="flex items-center gap-md">
                <div class="w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center font-headline-md">
                    @Model.Sender.FirstName[0]@Model.Sender.LastName[0]
                </div>
                <div>
                    <div class="flex items-center gap-sm">
                        <h3 class="font-body-lg text-body-lg font-medium text-on-surface">@Model.Sender.FirstName @Model.Sender.LastName</h3>
                        <span class="font-label-md text-label-md text-on-surface-variant">@Model.Sender.Email</span>
                    </div>
                    <div class="font-label-md text-label-md text-outline flex items-center gap-xs mt-xs">
                        Alıcı:@Model.Receiver.Email <span class="material-symbols-outlined" style="font-size: 16px;">arrow_drop_down</span>
                    </div>
                </div>
            </div>
        </header>
        <!-- Email Body -->
        <div class="font-body-md text-body-md text-on-surface space-y-md mb-lg whitespace-pre-wrap">
            @Model.Body
        </div>
       
        <!-- Footer Actions -->
        <footer class="flex items-center gap-md border-t border-surface-container-highest pt-md">
            <button class="px-md py-sm rounded-lg border border-[#EDE4E8] text-[#3A2E32] font-label-md text-label-md hover:bg-surface-container-low transition-colors flex items-center gap-base">
                <span class="material-symbols-outlined">reply</span>
                Yanıtla
            </button>
            
        </footer>
    </article>
    </div>
