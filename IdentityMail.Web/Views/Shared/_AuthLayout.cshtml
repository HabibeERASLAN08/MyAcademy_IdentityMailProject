
<!DOCTYPE html>

<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - HMail</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "primary": "#704261",
                      "secondary-fixed": "#d9e2ff",
                      "surface-variant": "#f1dee3",
                      "surface-tint": "#7f4f6f",
                      "surface": "#fff8f8",
                      "primary-fixed-dim": "#f0b5d9",
                      "surface-container": "#fde9ee",
                      "on-secondary-fixed-variant": "#394667",
                      "secondary-container": "#c9d6ff",
                      "on-surface": "#23191c",
                      "primary-fixed": "#ffd8ee",
                      "inverse-surface": "#392d31",
                      "on-primary-fixed": "#320d29",
                      "surface-dim": "#e9d5da",
                      "on-secondary": "#ffffff",
                      "on-error-container": "#93000a",
                      "surface-container-highest": "#f1dee3",
                      "error": "#ba1a1a",
                      "on-primary-fixed-variant": "#643856",
                      "tertiary-fixed-dim": "#e3c28e",
                      "on-error": "#ffffff",
                      "surface-container-low": "#fff0f3",
                      "tertiary": "#654d24",
                      "on-surface-variant": "#4f444a",
                      "inverse-primary": "#f0b5d9",
                      "tertiary-container": "#7f653a",
                      "secondary": "#515e80",
                      "on-background": "#23191c",
                      "inverse-on-surface": "#ffecf1",
                      "outline-variant": "#d2c2c9",
                      "primary-container": "#8b5a7a",
                      "on-secondary-fixed": "#0c1a39",
                      "on-tertiary-container": "#ffe6c3",
                      "secondary-fixed-dim": "#b9c6ed",
                      "on-tertiary": "#ffffff",
                      "on-tertiary-fixed": "#271900",
                      "on-primary-container": "#ffe3f1",
                      "on-tertiary-fixed-variant": "#59431b",
                      "surface-container-lowest": "#ffffff",
                      "surface-container-high": "#f7e3e8",
                      "surface-bright": "#fff8f8",
                      "on-primary": "#ffffff",
                      "tertiary-fixed": "#ffdeab",
                      "outline": "#81737a",
                      "error-container": "#ffdad6",
                      "on-secondary-container": "#505d7f",
                      "background": "#fff8f8",
                      // Adding specific colors requested in prompt not covered perfectly by design system named colors
                      "navy": "#3D4A6B",
                      "gold": "#C4A574",
                      "dark-brown": "#3A2E32",
                      "off-white": "#FFFCFB",
                      "border-light": "#EDE4E8"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px",
                      "card": "16px",
                      "input": "12px"
              },
              "spacing": {
                      "md": "24px",
                      "container-max": "1200px",
                      "xs": "4px",
                      "sm": "12px",
                      "auth-width": "420px",
                      "lg": "48px",
                      "base": "8px",
                      "xl": "80px",
                      "card-pad": "40px"
              },
              "fontFamily": {
                      "headline-md": ["Inter"],
                      "body-md": ["Inter"],
                      "code-sm": ["monospace"],
                      "display": ["Inter"],
                      "headline-lg": ["Inter"],
                      "body-lg": ["Inter"],
                      "label-md": ["Inter"],
                      "headline-lg-mobile": ["Inter"]
              },
              "fontSize": {
                      "headline-md": ["20px", {"lineHeight": "1.4", "fontWeight": "500"}],
                      "body-md": ["16px", {"lineHeight": "1.5", "fontWeight": "400"}],
                      "code-sm": ["13px", {"lineHeight": "1.4", "fontWeight": "400"}],
                      "display": ["48px", {"lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "600"}],
                      "headline-lg": ["32px", {"lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                      "body-lg": ["18px", {"lineHeight": "1.6", "fontWeight": "400"}],
                      "label-md": ["14px", {"lineHeight": "1", "letterSpacing": "0.01em", "fontWeight": "500"}],
                      "headline-lg-mobile": ["24px", {"lineHeight": "1.2", "fontWeight": "600"}]
              }
            }
          }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #FFFCFB;
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            overflow: hidden;
        }

        .shadow-ambient {
            box-shadow: 0px 4px 20px rgba(61, 74, 107, 0.04);
        }

        .input-focus:focus-within {
            border-color: #8B5A7A;
            box-shadow: 0 0 0 1px #8B5A7A;
        }

        .form-input {
            border-color: #EDE4E8;
        }

            .form-input:focus {
                border-color: #8B5A7A;
                box-shadow: 0 0 0 2px rgba(139, 90, 122, 0.2);
            }

        .custom-shadow {
            box-shadow: 0px 4px 20px rgba(61, 74, 107, 0.04);
        }
    </style>
</head>
<body class="flex w-full h-screen text-on-surface bg-off-white">
    <!-- Main Area -->
    <div class="w-full flex flex-col items-center justify-center p-6 bg-off-white relative">
        <!-- Brand Logo -->
        <div class="mb-10 text-center">
            <h1 class="font-display text-display tracking-tight text-navy flex items-baseline justify-center">
                <span class="text-gold">H</span>Mail
            </h1>
        </div>

@RenderBody()
    </div>
</body>
</html>